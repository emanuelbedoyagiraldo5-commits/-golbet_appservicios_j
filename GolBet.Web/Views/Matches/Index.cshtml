@using GolBet.Entities.Enums
@model IEnumerable<GolBet.Services.DTOs.MatchDto>
@{
    ViewData["Title"] = "Cartelera de partidos";
    var current = (MatchStatus?)ViewBag.CurrentStatus;
    var search = (string?)ViewBag.CurrentSearch;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>⚽ Cartelera de partidos</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">+ Nuevo partido</a>
    }
</div>

@* Team search: GET form, so the URL keeps the search (/Matches?search=nacional) *@
<form asp-action="Index" method="get" class="d-flex gap-2 mb-3">
    @if (current is not null)
    {
        @* keeps the active status filter when searching *@
        <input type="hidden" name="status" value="@current" />
    }
    <input type="search" name="search" value="@search" class="form-control"
           placeholder="Buscar por equipo (ej: nacional)" aria-label="Buscar por equipo" />
    <button type="submit" class="btn btn-success">Buscar</button>
</form>

@* Status filters keep the active search (asp-route-search) *@
<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Index" asp-route-search="@search"
       class="btn btn-sm @(current is null ? "btn-success" : "btn-outline-success")">
        Todos
    </a>
    <a asp-action="Index" asp-route-status="@MatchStatus.Scheduled" asp-route-search="@search"
       class="btn btn-sm @(current == MatchStatus.Scheduled ? "btn-success" : "btn-outline-success")">
        Programados
    </a>
    <a asp-action="Index" asp-route-status="@MatchStatus.InProgress" asp-route-search="@search"
       class="btn btn-sm @(current == MatchStatus.InProgress ? "btn-success" : "btn-outline-success")">
        En juego
    </a>
    <a asp-action="Index" asp-route-status="@MatchStatus.Finished" asp-route-search="@search"
       class="btn btn-sm @(current == MatchStatus.Finished ? "btn-success" : "btn-outline-success")">
        Finalizados
    </a>
</div>

@if (!Model.Any())
{
    if (!string.IsNullOrEmpty(search))
    {
        <div class="text-center py-5">
            <h1 class="display-4">🔍</h1>
            <h4>No hay partidos para “@search”</h4>
            <p class="text-muted">Prueba con otro nombre de equipo.</p>
            <a asp-action="Index" class="btn btn-success">Volver a la cartelera de partidos</a>
        </div>
    }
    else
    {
        <p class="text-muted">No hay partidos registrados todavía.</p>
    }
}

<div class="row g-3">
    @foreach (var match in Model)
    {
        var badgeClass = match.Status switch
        {
            "Scheduled" => "bg-success",
            "InProgress" => "bg-warning text-dark",
            _ => "bg-dark"
        };

        <div class="col-12 col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary">@match.Date.ToString("dd/MM/yyyy HH:mm")</span>
                        <span class="badge @badgeClass">@match.Status</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center text-center">
                        <div class="flex-fill">
                            <img src="@match.HomeTeamCrestUrl" alt="@match.HomeTeamName" width="48" height="48" />
                            <div class="fw-bold">@match.HomeTeamName</div>
                        </div>
                        <div class="px-2">
                            @if (match.HomeGoals.HasValue && match.AwayGoals.HasValue)
                            {
                                <span class="fs-4 fw-bold">@match.HomeGoals - @match.AwayGoals</span>
                            }
                            else
                            {
                                <span class="fs-5 text-muted">vs</span>
                            }
                        </div>
                        <div class="flex-fill">
                            <img src="@match.AwayTeamCrestUrl" alt="@match.AwayTeamName" width="48" height="48" />
                            <div class="fw-bold">@match.AwayTeamName</div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-around text-center">
                        <div>
                            <div class="text-muted small">Local</div>
                            <div class="fw-bold">@match.HomeOdds.ToString("0.00")</div>
                        </div>
                        <div>
                            <div class="text-muted small">Empate</div>
                            <div class="fw-bold">@match.DrawOdds.ToString("0.00")</div>
                        </div>
                        <div>
                            <div class="text-muted small">Visitante</div>
                            <div class="fw-bold">@match.AwayOdds.ToString("0.00")</div>
                        </div>
                    </div>

                    <a asp-action="Detail" asp-route-id="@match.Id"
                       class="btn btn-sm btn-outline-secondary w-100 mt-2">
                        Ver detalle
                    </a>
                </div>
            </div>
        </div>
    }
</div>
